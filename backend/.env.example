# 环境变量 — 复制为 .env 并填入真实值
# ⚠️  请勿将 .env 提交到 git

# ── 数据库 ──────────────────────────────────────────────────
DATABASE_URL="postgresql://jituo:your_strong_password@localhost:5432/jituo_prod"

# ── JWT ─────────────────────────────────────────────────────
# 生成随机密钥: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# ── Server酱 推送（管理员新订单微信通知）──────────────────
# 申请地址: https://sct.ftqq.com/
SERVERCHAN_TOKEN="SCT_your_serverchan_token"

# ── 管理员账号 ───────────────────────────────────────────────
# 生成哈希: node -e "require('bcrypt').hash('your_password',10).then(console.log)"
#
# ⚠️ Docker Compose 会对 env_file 的值做变量插值：哈希形如 $2b$10$xxxx，
#    其中的 $xxxx 会被替换成空串，哈希被静默截断成 $2b$10，管理员将无法登录。
#    用 docker compose 部署时，这里每个 $ 都要写成 $$，例如：
#      ADMIN_PASSWORD_HASH="$$2b$$10$$你的哈希其余部分"
#    （后端会把 $$ 还原成 $，所以同一份 .env 在 PM2/dotenv 路径下也能直接用。）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2b$10$placeholder_replace_with_real_bcrypt_hash"

# ── 管理员微信号（展示给用户的联系方式）──────────────────
ADMIN_WECHAT_ID="Jt--04"

# ── 邮件服务（Resend）────────────────────────────────────────
# 申请地址: https://resend.com
# 需要在 Resend 控制台验证域名后才能发送给任意用户
RESEND_API_KEY="re_your_api_key_here"
MAIL_FROM="noreply@jituo.online"

# ── 应用配置 ─────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
APP_BASE_URL="https://jituo.online"

# ── 本地上传目录 ─────────────────────────────────────────────
# 相对路径按后端进程的工作目录解析。
# ⚠️ 容器内 WORKDIR 是 /app（ENTRYPOINT 为 node backend/dist/app.js），
#    因此默认值 'uploads' 会解析成 /app/uploads —— 与 compose 的卷挂载路径不同，
#    容器化部署时请由 compose 显式指定（见 docker-compose.*.yml 的 UPLOAD_DIR）。
UPLOAD_DIR="uploads"

# ── 监控（管理端「监控大屏」的数据源）────────────────────────
# 指向 Prometheus 的 HTTP API。后端自身通过 /metrics 暴露指标供 Prometheus 抓取。
# ⚠️ 若后端跑在容器里、Prometheus 跑在宿主机，请用 host.docker.internal（compose 已配 host-gateway）
PROMETHEUS_URL="http://localhost:9090"
