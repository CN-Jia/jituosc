# 极拓空间 Nginx Dockerfile — 多阶段构建
# 从项目根目录构建: docker build -f Dockerfile.nginx -t jituo-nginx .
# 包含：用户端静态文件 + 管理端静态文件 + Nginx 反向代理配置

# ─── Stage 1: 构建用户端 (Frontend) ─────────────────────────────
FROM node:20-alpine AS build-frontend

RUN corepack enable && corepack prepare pnpm@10 --activate

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY frontend/package.json frontend/

RUN pnpm install --frozen-lockfile --filter jituo-frontend

COPY frontend/ frontend/

RUN pnpm --filter jituo-frontend build

# ─── Stage 2: 构建管理端 (Admin) ────────────────────────────────
FROM node:20-alpine AS build-admin

RUN corepack enable && corepack prepare pnpm@10 --activate

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY admin/package.json admin/

RUN pnpm install --frozen-lockfile --filter admin

COPY admin/ admin/

RUN pnpm --filter admin build

# ─── Stage 3: Nginx 最终镜像 ────────────────────────────────────
FROM nginx:alpine

# 安装 curl（健康检查用）+ 删除默认配置：合并为一条 RUN，减少镜像层
# 不锁 apk 包版本的理由：curl 是附加的探测工具，版本随 nginx:alpine 基础镜像走。
# hadolint ignore=DL3018
RUN apk add --no-cache curl \
  && rm -f /etc/nginx/conf.d/default.conf

# Nginx 配置
COPY deploy/nginx-docker.conf /etc/nginx/conf.d/jituo.conf

# 用户端静态文件
COPY --from=build-frontend /app/frontend/dist/ /usr/share/nginx/html/

# 管理端静态文件（/admin/ 子路径）
COPY --from=build-admin /app/admin/dist/ /usr/share/nginx/html/admin/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["curl", "-sf", "http://localhost:80/health"]
